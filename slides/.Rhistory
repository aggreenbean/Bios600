library(tidyverse)
mcd <- read_csv("data/menu.csv")
#| echo: true
#| eval: false
mcd_cal <- mcd |>
mutate(cal_oz = Calories/Oz) # create the new variable here
power.t.test(power = 0.90, # desired power
delta = 4, # difference to detect (mg/dL)
sd = 12, # population SD (mg/dL)
sig.level = 0.05,
type = "two.sample",
alternative = "two.sided")
