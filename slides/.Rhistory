data = study)
tidy(study_age) |>
kable(digits = 3)
library(tidyverse)
library(tidymodels)
library(knitr)
library(ppcor)
# Simulate data
set.seed(7)
n <- 100
age <- round(rnorm(n, mean = 50, sd = 12))
sbp <- round(105 + 0.65 * (age - 50) + rnorm(n, 0, 9))
cog <- round(82 + 0.40 * (age - 50) + 0.00 * (sbp - 130) + rnorm(n, 0, 7))
study <- data.frame(id = 1:n, age, sbp, cog)
study_sbp <- lm(cog ~ sbp,
data = study)
tidy(study_sbp) |>
kable(digits = 3)
study_age <- lm(cog ~ age,
data = study)
tidy(study_age) |>
kable(digits = 3)
study_age <- lm(cog ~ sbp + age,
data = study)
tidy(study_age) |>
kable(digits = 3)
cor(study$sbp, study$cog, study$age)
cor(study[,c("sbp","cog","age")]
cor(study[, c("sbp", "cog", "age")])
study_age <- lm(cog ~ sbp + age,
data = study)
tidy(study_age) |>
kable(digits = 3)
