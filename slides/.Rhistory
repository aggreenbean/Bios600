library(ggplot2)
set.seed(42)
n <- 100
fitted_vals <- seq(1, 10, length.out = n)
# --- Plot 1: Non-equal variance (funnel shape) ---
residuals_hetero <- rnorm(n, mean = 0, sd = 0.3 * fitted_vals)
df_hetero <- data.frame(fitted = fitted_vals, residuals = residuals_hetero)
df_hetero |> ggplot(aes(x = fitted, y = residuals)) +
geom_point(shape = 16, alpha = 0.6) +
geom_hline(yintercept = 0, linetype = "dashed", color = "darkred") +
geom_vline(xintercept = mean(fitted_vals), color = "darkred", linewidth = 1) +
labs(
title = "Non-Equal Variance",
x = expression(hat(y)[i] ~ "(Fitted)"),
y = expression(hat(epsilon)[i] ~ "(Residuals)")
) +
theme_minimal()
# --- Plot 2: Violates linearity (curved/quadratic pattern) ---
residuals_nonlinear <- -1.5 * (fitted_vals - 5.5)^2 + 10 + rnorm(n, sd = 1)
residuals_nonlinear <- residuals_nonlinear - mean(residuals_nonlinear)
df_nonlinear <- data.frame(fitted = fitted_vals, residuals = residuals_nonlinear)
df_nonlinear |> ggplot(aes(x = fitted, y = residuals)) +
geom_point(shape = 16, alpha = 0.6) +
geom_hline(yintercept = 0, linetype = "dashed", color = "darkred") +
geom_smooth(method = "loess", se = TRUE, color = "darkred", fill = "darkred", alpha = 0.2) +
labs(
title = "Violates Linearity",
subtitle = "Likely quadratic/polynomial model needed",
x = expression(hat(y)[i] ~ "(Fitted)"),
y = expression(hat(epsilon)[i] ~ "(Residuals)")
) +
theme_minimal()
# --- Plot 3: Equal variance (looks good!) ---
residuals_homo <- rnorm(n, mean = 0, sd = 1.5)
df_homo <- data.frame(fitted = fitted_vals, residuals = residuals_homo)
df_homo |> ggplot(aes(x = fitted, y = residuals)) +
geom_point(shape = 16, alpha = 0.6) +
geom_hline(yintercept = 0, linetype = "dashed", color = "darkred") +
labs(
title = "Equal Variance (Looks Good)",
x = expression(hat(y)[i] ~ "(Fitted)"),
y = expression(hat(epsilon)[i] ~ "(Residuals)")
) +
theme_minimal()
#| echo: false
#| eval: true
