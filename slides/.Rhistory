data(mtcars)
library(tidyverse)
library(ggcorrplot)
?mtcars
glimpse(mtcars)
data <- mtcars |>
select(mpg, cyl, disp, hp, drat, wt, qsec)
corr <- round(cor(data), 1)
ggcorrplot(corr)
cor(data$wt, data$mpg)
plot(data$wt, data$mpg)
#| echo: true
# Compute a correlation matrix
data(mtcars)
head(mtcars)
#| echo: true
# Looking at dataset mtcars
data(mtcars)
#Looking at just the first few observations
head(mtcars[, 1:6])
ggcorrplot(corr, p.mat = mtcars)
#| echo: true
# Compute a matrix of correlation p-values
p.mat <- cor_pmat(mtcars)
head(p.mat[, 1:4])
#| echo: true
ggcorrplot(p.mat)
ggcorrplot(mtcars, p.mat = mtcars)
rlang::last_trace()
?cor_pmat
ggcorrplot(corr, p.mat = p.mat)
ggcorrplot(corr, p.mat = cor_pmat(mtcars))
ugh <- cor_pmat(mtcars)
head(ugh[, 1:4])
ggcorrplot(ugh)
#| eval: false
p_value_corr_mtcars <- cor_pmat(mtcars)
head(p_value_corr_mtcars[, 1:4])
ggcorrplot(p_value_corr_mtcars)
#| echo: true
ggcorrplot(p.mat, sig=0.10)
#| echo: true
ggcorrplot(p.mat, sig=0.50)
#| echo: true
ggcorrplot(p.mat, sig=0.99)
