library(tidyverse)
library(tidymodels)
library(knitr)
library(ppcor)
# Simulate data
set.seed(7)
n <- 100
age <- round(rnorm(n, mean = 50, sd = 12))
sbp <- round(105 + 0.65 * (age - 50) + rnorm(n, 0, 9))
cog <- round(82 + 0.40 * (age - 50) + 0.05 * (sbp - 130) + rnorm(n, 0, 7))
study <- data.frame(id = 1:n, age, sbp, cog)
