# Fit ANOVA model
anova_res <- aov(anxiety_score ~ schedule, data = mh_data)
#| echo: false
library(ggplot2)
ggplot(mh_data, aes(x = schedule, y = anxiety_score, fill = schedule)) +
geom_boxplot() +
labs(
title = "Anxiety Scores by Work Schedule",
x = "Work Schedule",
y = "Anxiety Score (0–42 scale)"
) +
theme_minimal() +
theme(legend.position = "none")
#| echo: false
set.seed(2025)
n <- 30  # employees per group
groups <- rep(c("Standard_9to5", "Fully_Remote", "Night_Shift"), each = n)
anxiety <- c(
rnorm(n, mean = 11, sd = 4.5),  # Standard 9–5
rnorm(n, mean = 8.5, sd = 3.8), # Fully Remote
rnorm(n, mean = 15.2, sd = 5.1) # Night Shift
)
mh_data <- data.frame(
schedule = factor(groups),
anxiety_score = anxiety
)
#| echo: false
library(ggplot2)
ggplot(mh_data, aes(x = schedule, y = anxiety_score, fill = schedule)) +
geom_boxplot() +
labs(
title = "Anxiety Scores by Work Schedule",
x = "Work Schedule",
y = "Anxiety Score (0–42 scale)"
) +
theme_minimal() +
theme(legend.position = "none")
#| echo: false
#| eval: false
# Fit ANOVA model
anova_res <- aov(anxiety_score ~ schedule, data = mh_data)
summary(anova_res)
View(anova_res)
